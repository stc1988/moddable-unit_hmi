{
	"include": ["src/**/*", "examples/**/*"],
	"compilerOptions": {
		"incremental": false,
		"outDir": "dist",
		"lib": ["es2025", "esnext.disposable"],
		"module": "es2022",
		"sourceMap": true,
		"target": "es2025",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": false,
		"noImplicitThis": false,
		"strictNullChecks": false,
		"paths": {
			"input/analog": ["./src/input/analog/analogInput"],
			"input/polling": ["./src/input/polling/pollingInput"],
			"joystick/input": ["./src/input/joystick/joystickInput"],
			"unit/8angle": ["./src/drivers/unit/8angle/8angle"],
			"unit/8encoder": ["./src/drivers/unit/8encoder/8encoder"],
			"unit/angle": ["./src/drivers/unit/angle/angle"],
			"unit/bytebutton": ["./src/drivers/unit/bytebutton/bytebutton"],
			"unit/byteswitch": ["./src/drivers/unit/byteswitch/byteswitch"],
			"unit/fader": ["./src/drivers/unit/fader/fader"],
			"unit/joystick": ["./src/drivers/unit/joystick/joystick"],
			"unit/joystick2": ["./src/drivers/unit/joystick2/joystick2"],
			"unit/scroll": ["./src/drivers/unit/scroll/scroll"],
			"hat/mini-joyc": ["./src/drivers/hat/mini-joyc/mini-joyc"],
			"*": [
				"./node_modules/@moddable/typings/*",
				"./node_modules/@moddable/typings/ble/*",
				"./node_modules/@moddable/typings/web/*",
				"./src/deviceFeatures/*",
				"./src/drivers/unit/8angle/*",
				"./src/drivers/unit/8encoder/*",
				"./src/drivers/unit/angle/*",
				"./src/drivers/unit/bytebutton/*",
				"./src/drivers/unit/byteswitch/*",
				"./src/drivers/unit/fader/*",
				"./src/drivers/unit/joystick/*",
				"./src/drivers/unit/joystick2/*",
				"./src/drivers/unit/scroll/*",
				"./src/drivers/hat/mini-joyc/*"
			],
			"commodetto/*": ["./node_modules/@moddable/typings/commodetto/*"],
			"dns/*": ["./node_modules/@moddable/typings/dns/*"],
			"mc/*": ["./node_modules/@moddable/typings/mc/*"],
			"mod/*": ["./node_modules/@moddable/typings/mod/*"],
			"pins/*": ["./node_modules/@moddable/typings/pins/*"],
			"piu/*": ["./node_modules/@moddable/typings/piu/*"],
			"text/*": ["./node_modules/@moddable/typings/text/*"],
			"embedded:io/*": ["./node_modules/@moddable/typings/embedded_io/*"],
			"embedded:io/audio/*": ["./node_modules/@moddable/typings/embedded_io/audio/*"],
			"embedded:io/bluetoothle/*": ["./node_modules/@moddable/typings/embedded_io/ble/*"],
			"embedded:io/socket/*": ["./node_modules/@moddable/typings/embedded_io/socket/*"],
			"embedded:network/http/*": ["./node_modules/@moddable/typings/embedded_network/http/*"],
			"embedded:network/mqtt/*": ["./node_modules/@moddable/typings/embedded_network/mqtt/*"],
			"embedded:network/websocket/*": ["./node_modules/@moddable/typings/embedded_network/websocket/*"],
			"embedded:network/dns/resolver/*": ["./node_modules/@moddable/typings/embedded_network/dns/resolver/*"],
			"embedded:network/interface/*": ["./node_modules/@moddable/typings/embedded_network/interface/*"],
			"embedded:storage/*": ["./node_modules/@moddable/typings/embedded/storage/*"],
			"embedded:provider/*": ["./node_modules/@moddable/typings/embedded_provider/*"]
		},
		"types": [
			"./node_modules/@moddable/typings/xs",
			"./node_modules/@moddable/typings/mcpack",
			"./node_modules/@moddable/typings/global"
		]
	}
}
